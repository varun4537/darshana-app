rules_version = '2';
//
// Darshana — Firestore Security Rules
//
// Deploy with:  firebase deploy --only firestore:rules
//
// Structure:
//   /users/{userId}          — per-user progress document
//
// Design decisions:
//   • Only the authenticated owner can read or write their own document.
//   • No cross-user reads — a logged-in user cannot access another user's data.
//   • No unauthenticated reads — the document is never public.
//   • No admin bypass is implemented here; use the Firebase Admin SDK
//     server-side (e.g., in a webhook handler) for privileged writes.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── User progress ────────────────────────────────────────────────────────
    match /users/{userId} {
      // Only the user themselves can read their own document.
      allow read: if request.auth != null && request.auth.uid == userId;

      // Clients may write only the progress/preference fields listed in
      // isValidUserStats.  Billing fields (isPremium, stripeCustomerId, etc.)
      // are intentionally excluded — they are written server-side by the
      // Stripe webhook handler using the Admin SDK, which bypasses these rules.
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && isValidUserStats(request.resource.data);
    }

    // ── Deny everything else by default ─────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// ── Helper: validate the UserStats document shape ────────────────────────────
function isValidUserStats(data) {
  return
    // Required numeric fields
    (!('totalMeditationMinutes' in data) || data.totalMeditationMinutes is number)
    && (!('sessionsCompleted'        in data) || data.sessionsCompleted is number)
    && (!('streakDays'               in data) || data.streakDays is number)
    // completedConcepts must be a list if present
    && (!('completedConcepts' in data) || data.completedConcepts is list)
    // recentlyStudied must be a list if present
    && (!('recentlyStudied'   in data) || data.recentlyStudied is list)
    // activePlans must be a map if present
    && (!('activePlans'       in data) || data.activePlans is map)
    // Disallow unexpected fields that might indicate a client-side injection
    && data.keys().hasOnly([
         'totalMeditationMinutes',
         'sessionsCompleted',
         'streakDays',
         'lastMeditationDate',
         'activePlans',
         'completedConcepts',
         'recentlyStudied',
         'lastSyncedAt'
       ]);
}
